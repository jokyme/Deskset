; Strings-Chinese.inc has the same keys. Menu titles are Title Case and at most 30 characters.

[Variables]
; the date window under 12: "SAT 26" (the meter sets it in capitals)
AnalogDateWindowFormat=%a %#d
; the card's sentence: "10:09, Saturday, September 26, 2026", then the time zone's name and its offset from UTC
AnalogTip=[MeasureTipTime], [MeasureTipDate]#CRLF#[MeasureTipZone] ([MeasureTipOffset])
; the right-click menu, by the current value
AnalogMenuFaceDayNight=Face: Day and Night
AnalogMenuFaceGlass=Face: Glass
AnalogMenuNumeralsAll=Numerals: All
AnalogMenuNumeralsQuarters=Numerals: Quarters
AnalogMenuNumeralsTicks=Numerals: Ticks
AnalogMenuSeconds1=Seconds Hand: On
AnalogMenuSeconds0=Seconds Hand: Off
AnalogMenuDate1=Date Window: On
AnalogMenuDate0=Date Window: Off
