[Variables]
; ---------------------------------------------------------------- menu
BatteryMenuOpen=打开电池设置
BatteryMenuOpenEnergy=打开节能设置

; ---------------------------------------------------------------- the status line
BatteryStatus0=
BatteryStatus1=正在充电
BatteryStatus2=%1后充满
BatteryStatus3=剩余 %1
BatteryStatus4=正在使用电池
BatteryStatus5=已充满
BatteryStatus6=已暂停充电
BatteryStatus7=低电量模式

; ---------------------------------------------------------------- the Medium's rows
BatteryHealth=最大容量
BatteryCycles=循环计数
BatteryTemperature=温度
BatteryPower=功率
BatteryAdapter=电源适配器
BatteryUnplugged=未连接
BatteryPowerAdapter=电源适配器

; ---------------------------------------------------------------- a Mac without a battery
BatteryNoBattery=没有电池
BatteryNoBatteryBody=这台 Mac 没有电池。

; ---------------------------------------------------------------- tooltips
BatteryTipJoin=，
BatteryTipState0=这台 Mac 没有电池。
BatteryTipState1=正在充电。
BatteryTipState2=正在充电，[MeasureDuration]后充满。
BatteryTipState3=正在使用电池，剩余 [MeasureDuration]。
BatteryTipState4=正在使用电池。
BatteryTipState5=已充满。
BatteryTipState6=已暂停充电。Mac 已接通电源，但为了保护电池暂不充电。
BatteryTipState7=低电量模式已打开。
BatteryTipHealth=最大容量 [MeasureHealthText]，循环 [MeasureCyclesText] 次。
