; Stationery — the Dark look: white ink on dark glass. Original work, MIT licensed.
; The same names as Light.inc; see there for what each is for.

[Variables]
LookAppearance=Dark
LookTheme=Dark
MoonSuffix=

; ---------------------------------------------------------------- ink
InkRGB=255,255,255
Alpha1=230
Alpha2=166
Alpha3=122
Alpha4=46
TextColor=#InkRGB#,#Alpha1#
SecondaryTextColor=#InkRGB#,#Alpha2#
TertiaryTextColor=#InkRGB#,#Alpha3#
FaintColor=#InkRGB#,#Alpha4#
SeparatorColor=255,255,255,26
HoverColor=255,255,255,26
PressedColor=255,255,255,51
ControlFillColor=255,255,255,31
KnobColor=255,255,255,56
FieldColor=50,50,52,255
EditPadColor=255,255,255,31

; ---------------------------------------------------------------- the card
Glass=Regular
GlassTint=0,0,0,56
Veil0=28,28,30,90
Veil1=36,36,38,235
TrackAlpha=64

; ---------------------------------------------------------------- system colours (macOS 26, dark)
Red=255,66,69
Orange=255,146,48
Yellow=255,214,0
Green=48,209,88
Mint=0,218,195
Teal=0,210,224
Cyan=60,211,254
Blue=0,145,255
Indigo=109,124,255
Purple=219,52,242
Pink=255,55,95
Brown=183,138,102
Gray=152,152,157

; ---------------------------------------------------------------- data categories
CPUColor=#Blue#
MemoryColor=#Green#
StorageColor=#Orange#
GPUColor=#Purple#
DownloadColor=#Blue#
UploadColor=#Orange#
TemperatureColor=#Orange#
FanColor=#Teal#
PowerColor=#Yellow#
BatteryColor=#Green#
MediaColor=#Pink#
CalendarColor=#Red#
ClockHandColor=#Orange#
TimerColor=#Orange#
PrecipitationColor=#Cyan#
SunColor=#Yellow#

; ---------------------------------------------------------------- status
WarningColor=#Yellow#
CriticalColor=#Red#

; ---------------------------------------------------------------- accent
AccentColor=#MACACCENTCOLOR#

; ---------------------------------------------------------------- coloured text
AccentTextColor=145,198,255
CalendarTextColor=255,172,172
CriticalTextColor=255,172,172
PrecipitationTextColor=60,211,254
