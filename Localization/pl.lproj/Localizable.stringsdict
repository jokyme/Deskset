<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>(+%lld more)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>(+%lld inne)</string>
			<key>many</key>
			<string>(+%lld innych)</string>
			<key>one</key>
			<string>(+%lld inna)</string>
			<key>other</key>
			<string>(+%lld innej)</string>
		</dict>
	</dict>
	<key>Contains %lld skins.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Zawiera %lld skórki.</string>
			<key>many</key>
			<string>Zawiera %lld skórek.</string>
			<key>one</key>
			<string>Zawiera %lld skórkę.</string>
			<key>other</key>
			<string>Zawiera %lld skórki.</string>
		</dict>
	</dict>
	<key>Move %lld items to the Trash?</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Przenieść %lld rzeczy do kosza?</string>
			<key>many</key>
			<string>Przenieść %lld rzeczy do kosza?</string>
			<key>one</key>
			<string>Przenieść %lld rzecz do kosza?</string>
			<key>other</key>
			<string>Przenieść %lld rzeczy do kosza?</string>
		</dict>
	</dict>
	<key>… and %lld more items.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>… i jeszcze %lld rzeczy.</string>
			<key>many</key>
			<string>… i jeszcze %lld rzeczy.</string>
			<key>one</key>
			<string>… i jeszcze %lld rzecz.</string>
			<key>other</key>
			<string>… i jeszcze %lld rzeczy.</string>
		</dict>
	</dict>
	<key>… and %lld more notes.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>… i jeszcze %lld uwagi.</string>
			<key>many</key>
			<string>… i jeszcze %lld uwag.</string>
			<key>one</key>
			<string>… i jeszcze %lld uwaga.</string>
			<key>other</key>
			<string>… i jeszcze %lld uwagi.</string>
		</dict>
	</dict>
	<key>… and %lld more.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>… i jeszcze %lld.</string>
			<key>many</key>
			<string>… i jeszcze %lld.</string>
			<key>one</key>
			<string>… i jeszcze %lld.</string>
			<key>other</key>
			<string>… i jeszcze %lld.</string>
		</dict>
	</dict>
</dict>
</plist>
