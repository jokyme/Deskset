    "Save your edits when prompted, then Deskset will restart." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "احفظ تعديلاتك عند المطالبة؛ ثم سيُعاد تشغيل Deskset."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Запазете промените си, когато бъдете подканени; след това Deskset ще се рестартира."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Po vyzvání uložte úpravy; potom se Deskset restartuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arkiver dine ændringer, når du bliver bedt om det; derefter genstarter Deskset."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sichere deine Änderungen, wenn du gefragt wirst; danach startet Deskset neu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Αποθηκεύστε τις αλλαγές σας όταν σας ζητηθεί· έπειτα το Deskset θα επανεκκινηθεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Guarda tus ediciones cuando se te pida; después, Deskset se reiniciará."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Salvesta muudatused, kui seda palutakse; seejärel Deskset taaskäivitub."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tallenna muutoksesi, kun sitä pyydetään; sen jälkeen Deskset käynnistyy uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Enregistrez vos modifications lorsque vous y êtes invité ; Deskset redémarrera ensuite."
          }
        },
        "he" : {
