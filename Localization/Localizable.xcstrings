    "Hold Control to change zoom by 10 percentage points." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اضغط مع الاستمرار على Control لتغيير التكبير بخطوات من 10 نقاط مئوية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Задръжте Control, за да променяте мащаба на стъпки от 10 процентни пункта."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Podržením Ctrl měníte zvětšení po 10 procentních bodech."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hold ctrl nede for at ændre zoom i trin på 10 procentpoint."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Halte ctrl gedrückt, um den Zoom in Schritten von 10 Prozentpunkten zu ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Κρατήστε πατημένο το Control για να αλλάζετε το ζουμ ανά 10 ποσοστιαίες μονάδες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantén pulsada la tecla Control para cambiar el zoom en pasos de 10 puntos porcentuales."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hoia all Controli, et muuta suumi 10 protsendipunkti kaupa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pidä ctrl painettuna muuttaaksesi zoomausta 10 prosenttiyksikön askelin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Maintenez Contrôle pour modifier le zoom par pas de 10 points de pourcentage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "החזק/י את Control כדי לשנות את ההגדלה בצעדים של 10 נקודות אחוז."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Držite Control da biste mijenjali zumiranje u koracima od 10 postotnih bodova."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tartsa lenyomva a Control billentyűt, hogy a nagyítást 10 százalékpontonként módosítsa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tahan Control untuk mengubah zoom per 10 poin persentase."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tieni premuto Ctrl per modificare lo zoom di 10 punti percentuali alla volta."
          }
