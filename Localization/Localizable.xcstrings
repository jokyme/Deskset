        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Скинови у фасцикли Skins апликације Deskset су већ инсталирани, па нема шта да се копира. Ако скин који сте тамо ставили недостаје на листи, у прозору за управљање изаберите Освежи све."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
