    "%@ can’t jump to a line; files open at the top." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لا يمكن لـ %@ الانتقال إلى سطر؛ تُفتح الملفات من البداية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ не може да отиде на ред; файловете се отварят от началото."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ neumí přejít na řádek; soubory se otevírají od začátku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ kan ikke gå til en linje; filer åbnes øverst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ kann nicht zu einer Zeile springen; Dateien werden am Anfang geöffnet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το %@ δεν μπορεί να μεταβεί σε γραμμή· τα αρχεία ανοίγουν από την αρχή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ no puede ir a una línea; los archivos se abren al principio."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ei oska reale hüpata; failid avanevad algusest."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ei voi siirtyä riville; tiedostot avautuvat alusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ne peut pas aller à une ligne ; les fichiers s’ouvrent au début."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "‏%@ לא יכול לקפוץ לשורה; קבצים נפתחים מההתחלה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ne može skočiti na redak; datoteke se otvaraju od početka."
