    "Snap to screen edges and other skins when dragged. Hold ⌘ while dragging to override." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الالتصاق بحواف الشاشة والواجهات الأخرى عند السحب. اضغط مع الاستمرار على ⌘ أثناء السحب لتجاوز ذلك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Залепване към ръбовете на екрана и към други скинове при плъзгане. Задръжте ⌘ по време на плъзгане, за да го пренебрегнете."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Při přetahování přichytávat k okrajům obrazovky a k jiným skinům. Podržením ⌘ při přetahování to obejdete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fastgør til skærmkanter og andre skins, når der trækkes. Hold ⌘ nede, mens du trækker, for at tilsidesætte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beim Bewegen an Bildschirmrändern und anderen Skins einrasten. Halte beim Bewegen ⌘ gedrückt, um das zu umgehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Προσκόλληση στα άκρα της οθόνης και σε άλλα skin κατά τη μεταφορά. Κρατήστε πατημένο το ⌘ κατά τη μεταφορά για παράκαμψη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ajustar a los bordes de la pantalla y a otros skins al arrastrar. Mantén pulsada ⌘ mientras arrastras para evitarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Haagi lohistamisel ekraani servadele ja teistele skinidele. Selle eiramiseks hoia lohistamise ajal all ⌘."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kohdista vedettäessä näytön reunoihin ja muihin skineihin. Ohita pitämällä ⌘ painettuna vedettäessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "S’aimanter aux bords de l’écran et aux autres skins pendant le déplacement. Maintenez ⌘ pendant le déplacement pour l’ignorer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הצמד לקצוות המסך ולסקינים אחרים בעת גרירה. החזק/י את ⌘ בזמן הגרירה כדי לעקוף."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pri povlačenju prianjaj uz rubove zaslona i druge skinove. Držite ⌘ tijekom povlačenja da biste to zaobišli."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Húzáskor igazítás a képernyő széleihez és más skinekhez. A felülbíráláshoz húzás közben tartsa lenyomva a ⌘ billentyűt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tempelkan ke tepi layar dan skin lain saat diseret. Tahan ⌘ saat menyeret untuk mengabaikannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aggancia ai bordi dello schermo e ad altri skin durante il trascinamento. Tieni premuto ⌘ mentre trascini per ignorarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ドラッグしたときに画面の端やほかのスキンにスナップします。ドラッグ中に ⌘ キーを押したままにすると無効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "드래그할 때 화면 가장자리와 다른 스킨에 맞춥니다. 드래그하는 동안 ⌘을 누르고 있으면 무시합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vilkdami pritraukti prie ekrano kraštų ir kitų apvalkalų. Norėdami to išvengti, vilkdami laikykite ⌘."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vilkšanas laikā piesaistīt ekrāna malām un citiem apvalkiem. Lai to apietu, vilkšanas laikā turiet ⌘."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lekat pada tepi skrin dan skin lain semasa diseret. Tahan ⌘ semasa menyeret untuk mengatasinya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fest til skjermkanter og andre skins ved draing. Hold inne ⌘ mens du drar, for å overstyre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Klik bij het slepen vast aan schermranden en andere skins. Houd ⌘ ingedrukt tijdens het slepen om dit te omzeilen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
