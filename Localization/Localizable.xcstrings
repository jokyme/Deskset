    "macOS needs your approval. Turn on Deskset in System Settings › General › Login Items." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يحتاج macOS إلى موافقتك. شغّل Deskset في إعدادات النظام › عام › عناصر تسجيل الدخول."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS се нуждае от вашето одобрение. Включете Deskset в Системни настройки › Общи › Обекти при влизане."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS potřebuje váš souhlas. Zapněte Deskset v Nastavení systému › Obecné › Položky otevírané po přihlášení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS skal have din godkendelse. Slå Deskset til i Systemindstillinger › Generelt › Emner ved log ind."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS braucht deine Zustimmung. Aktiviere Deskset unter „Systemeinstellungen“ › „Allgemein“ › „Anmeldeobjekte“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το macOS χρειάζεται την έγκρισή σας. Ενεργοποιήστε το Deskset στις Ρυθμίσεις συστήματος › Γενικά › Στοιχεία σύνδεσης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS necesita tu aprobación. Activa Deskset en Ajustes del Sistema › General › Ítems de inicio."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS vajab sinu nõusolekut. Lülita Deskset sisse jaotises Süsteemiseaded › Üldine › Sisselogimisüksused."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS tarvitsee hyväksyntäsi. Laita Deskset päälle kohdassa Järjestelmäasetukset › Yleiset › Kirjautumisen yhteydessä avattavat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS a besoin de votre autorisation. Activez Deskset dans Réglages Système › Général › Ouverture."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "‏macOS זקוק לאישורך. הפעל/י את Deskset ב״הגדרות המערכת״ › ״כללי״ › ״פריטי התחברות״."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS treba vaše odobrenje. Uključite Deskset u Postavke sustava › Općenito › Stavke za prijavu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A macOS-nek szüksége van a jóváhagyására. Kapcsolja be a Desksetet a Rendszerbeállítások › Általános › Bejelentkezési elemek területen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS memerlukan persetujuan Anda. Aktifkan Deskset di Pengaturan Sistem › Umum › Item Masuk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
