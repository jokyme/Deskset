    "It contains several skin packages (%@). Open them one at a time (extract the archive first when it is one)." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يحتوي على عدة حزم واجهات (%@). افتحها واحدة تلو الأخرى (إذا كان أرشيفًا، فقم بفك ضغطه أولًا)."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Съдържа няколко пакета със скинове (%@). Отваряйте ги един по един (ако е архив, първо го разархивирайте)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Obsahuje několik balíčků skinů (%@). Otevírejte je po jednom (pokud jde o archiv, nejprve ho rozbalte)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Den indeholder flere skinpakker (%@). Åbn dem én ad gangen (pak arkivet ud først, hvis det er et)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Es enthält mehrere Skin-Pakete (%@). Öffne sie einzeln (entpacke das Archiv zuerst, falls es eines ist)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Περιέχει πολλά πακέτα skin (%@). Ανοίξτε τα ένα-ένα (αν είναι αρχειοθετημένο αρχείο, αποσυμπιέστε το πρώτα)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Contiene varios paquetes de skins (%@). Ábrelos de uno en uno (si es un archivo comprimido, descomprímelo primero)."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "See sisaldab mitut skinipaketti (%@). Ava need ükshaaval (kui see on arhiiv, paki see esmalt lahti)."
          }
        },
        "fi" : {
