    "Moving it does not bring it back; Show does, until it is loaded again." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "النقل لا يعيدها؛ أما إظهار فيعيدها حتى يُعاد تحميلها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Преместването не го връща; Показване го връща, докато не бъде зареден отново."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Přesunutí ho nevrátí; Zobrazit ano, dokud nebude znovu načten."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Det kommer ikke tilbage, fordi det flyttes; Vis gør det, indtil det indlæses igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bewegen bringt ihn nicht zurück; „Einblenden“ schon, bis er erneut geladen wird."
