<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>(+%lld more)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>(încă %lld)</string>
			<key>few</key>
			<string>(încă %lld)</string>
			<key>other</key>
			<string>(încă %lld)</string>
		</dict>
	</dict>
	<key>Contains %lld skins.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Conține %lld skin.</string>
			<key>few</key>
			<string>Conține %lld skinuri.</string>
			<key>other</key>
			<string>Conține %lld de skinuri.</string>
		</dict>
	</dict>
	<key>Move %lld items to the Trash?</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Mutați %lld articol în Coș?</string>
			<key>few</key>
			<string>Mutați %lld articole în Coș?</string>
			<key>other</key>
			<string>Mutați %lld de articole în Coș?</string>
		</dict>
	</dict>
	<key>… and %lld more items.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>… și încă %lld articol.</string>
			<key>few</key>
			<string>… și încă %lld articole.</string>
			<key>other</key>
			<string>… și încă %lld de articole.</string>
		</dict>
	</dict>
	<key>… and %lld more notes.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>… și încă %lld notă.</string>
			<key>few</key>
			<string>… și încă %lld note.</string>
			<key>other</key>
			<string>… și încă %lld de note.</string>
		</dict>
	</dict>
	<key>… and %lld more.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>… și încă %lld.</string>
			<key>few</key>
			<string>… și încă %lld.</string>
			<key>other</key>
			<string>… și încă %lld.</string>
		</dict>
	</dict>
</dict>
</plist>
