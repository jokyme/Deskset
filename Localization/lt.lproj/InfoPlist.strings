/* macOS permission prompt (system audio recording) for audio visualizer skins. */
"NSAudioCaptureUsageDescription" = "Garso vizualizavimo apvalkalai rodo jūsų „Mac“ kompiuterio atkuriamo garso lygį ir spektrą. Garsas analizuojamas jūsų „Mac“ kompiuteryje, kol toks apvalkalas įkeltas; jis niekada neįrašomas, nesaugomas ir niekur nesiunčiamas.";

/* macOS permission prompt (Files and Folders › Desktop). */
"NSDesktopFolderUsageDescription" = "Apvalkalas arba jo scenarijus skaito arba rašo failus jūsų aplanke „Darbalaukis“ (pvz., failų sąrašo, užrašų ar paleidiklio apvalkalas).";

/* macOS permission prompt (Files and Folders › Documents). */
"NSDocumentsFolderUsageDescription" = "Apvalkalas arba jo scenarijus skaito arba rašo failus jūsų aplanke „Dokumentai“ (pvz., failų sąrašo, užrašų ar paleidiklio apvalkalas).";

/* macOS permission prompt (Files and Folders › Downloads). */
"NSDownloadsFolderUsageDescription" = "Apvalkalas arba jo scenarijus skaito arba rašo failus jūsų aplanke „Atsisiuntimai“ (pvz., failų sąrašo ar paleidiklio apvalkalas).";

/* The copyright line Finder's Get Info window shows. A legal line; translate faithfully. */
