/* macOS permission prompt (system audio recording) for audio visualizer skins. */
"NSAudioCaptureUsageDescription" = "Скинови за визуелизацију звука приказују ниво и спектар звука који репродукује ваш Mac. Звук се анализира на вашем Mac рачунару док је такав скин учитан; никада се не снима, не чува и не шаље нигде.";

/* macOS permission prompt (Files and Folders › Desktop). */
"NSDesktopFolderUsageDescription" = "Скин или његова скрипта чита или уписује датотеке у фасцикли Радна површина (на пример скин са листом датотека, белешкама или за покретање апликација).";

/* macOS permission prompt (Files and Folders › Documents). */
"NSDocumentsFolderUsageDescription" = "Скин или његова скрипта чита или уписује датотеке у фасцикли Документи (на пример скин са листом датотека, белешкама или за покретање апликација).";

/* macOS permission prompt (Files and Folders › Downloads). */
