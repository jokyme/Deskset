/* macOS permission prompt (Automation): why Deskset controls Music, Spotify and Finder. */
NSAppleEventsUsageDescription = "סקינים שואלים את ”מוזיקה“ או את Spotify מה מתנגן כדי להציג את הרצועה הנוכחית ולשלוט בניגון, ומבקשים מ‑Finder לרוקן את הפח או לפתוח חלון ”הצג מידע“ כשמשתמשים בסקין כזה.";

/* macOS permission prompt (system audio recording) for audio visualizer skins. */
NSAudioCaptureUsageDescription = "סקינים להמחשת שמע מציגים את העוצמה ואת הספקטרום של הצליל שה‑Mac מנגן. השמע מנותח ב‑Mac כל עוד סקין כזה טעון; הוא לעולם אינו מוקלט, נשמר או נשלח לשום מקום.";

/* macOS permission prompt (Files and Folders › Desktop). */
NSDesktopFolderUsageDescription = "סקין או הסקריפט שלו קורא או כותב קבצים בתיקייה ”שולחן העבודה“ (למשל סקין של רשימת קבצים, פתקים או משגר).";

/* macOS permission prompt (Files and Folders › Documents). */
NSDocumentsFolderUsageDescription = "סקין או הסקריפט שלו קורא או כותב קבצים בתיקייה ”מסמכים“ (למשל סקין של רשימת קבצים, פתקים או משגר).";

/* macOS permission prompt (Files and Folders › Downloads). */
