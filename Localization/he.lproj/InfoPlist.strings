/* The copyright line Finder's Get Info window shows. A legal line; translate faithfully. */
"NSHumanReadableCopyright" = "תוכנה חופשית ברישיון GNU GPL v3. מריצה סקינים שנוצרו עבור Rainmeter; אינה קשורה ל‑Rainmeter. ‏Rainmeter הוא סימן מסחרי של בעליו.";

/* macOS permission prompt (Local Network). */
NSLocalNetworkUsageDescription = "סקין קורא מידע ממכשיר ברשת המקומית שלך, כמו דף המצב של נתב או שרת ביתי.";

/* macOS permission prompt (Location Services). Keep "MET Norway" (the weather service's name). */
NSLocationUsageDescription = "סקינים שהגדרת להשתמש במיקום הנוכחי שלך קוראים את המיקום המשוער שלך כדי להציג את מזג האוויר המקומי ואת שעות הזריחה והשקיעה. המיקום מעוגל לכ‑1 ק״מ, נשלח רק לשירות מזג האוויר (MET Norway) לצורך התחזית, ולעולם אינו נשמר. ‏macOS דורש את ההרשאה הזו גם כדי שסקינים של Wi-Fi יוכלו להציג שמות רשתות.";

/* macOS permission prompt (Location Services); the same text as NSLocationUsageDescription. */
