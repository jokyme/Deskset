    "NSAppleEventsUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تسأل الواجهات تطبيق الموسيقى أو Spotify عما يتم تشغيله لعرض المقطع الحالي والتحكم في التشغيل، وتطلب من Finder إفراغ سلة المهملات أو فتح نافذة \"معلومات\" عند استخدامك لمثل هذه الواجهة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Скиновете питат Музика или Spotify какво звучи, за да покажат текущата песен и да управляват възпроизвеждането, и молят Finder да изпразни кошчето или да отвори прозорец Информация, когато използвате такъв скин."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skiny se ptají aplikace Hudba nebo Spotify, co právě hraje, aby zobrazily aktuální skladbu a ovládaly přehrávání, a žádají Finder o vysypání koše nebo otevření okna Informace, když takový skin používáte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skins spørger Musik eller Spotify, hvad der afspilles, for at vise det aktuelle nummer og styre afspilningen, og beder Finder om at tømme papirkurven eller åbne et infovindue, når du bruger et sådant skin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skins fragen Musik oder Spotify, was gerade läuft, um den aktuellen Titel anzuzeigen und die Wiedergabe zu steuern, und bitten den Finder, den Papierkorb zu entleeren oder ein Informationsfenster zu öffnen, wenn du einen solchen Skin verwendest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Τα skin ρωτούν τη Μουσική ή το Spotify τι αναπαράγεται για να δείξουν το τρέχον κομμάτι και να ελέγξουν την αναπαραγωγή, και ζητούν από το Finder να αδειάσει τον Κάδο ή να ανοίξει ένα παράθυρο Λήψης πληροφοριών όταν χρησιμοποιείτε ένα τέτοιο skin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skins ask Music or Spotify what is playing to show the current track and control playback, and ask Finder to empty the Trash or open a Get Info window when you use such a skin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los skins preguntan a Música o a Spotify qué se está reproduciendo para mostrar la pista actual y controlar la reproducción, y piden al Finder que vacíe la papelera o abra una ventana de Obtener información cuando usas uno de esos skins."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skinid küsivad rakenduselt Muusika või Spotify, mis mängib, et näidata praegust lugu ja juhtida taasesitust, ning paluvad Finderil tühjendada prügikasti või avada teabeakna, kui kasutad sellist skini."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skinit kysyvät Musiikilta tai Spotifylta, mitä soitetaan, näyttääkseen nykyisen kappaleen ja ohjatakseen toistoa, ja pyytävät Finderia tyhjentämään roskakorin tai avaamaan Näytä tiedot -ikkunan, kun käytät tällaista skiniä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les skins demandent à Musique ou Spotify ce qui est en cours de lecture pour afficher le morceau actuel et contrôler la lecture, et demandent au Finder de vider la corbeille ou d’ouvrir une fenêtre Lire les informations lorsque vous utilisez un tel skin."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "סקינים שואלים את ״מוזיקה״ או את Spotify מה מתנגן כדי להציג את הרצועה הנוכחית ולשלוט בניגון, ומבקשים מ-Finder לרוקן את הפח או לפתוח חלון ״קבל מידע״ כשמשתמשים בסקין כזה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skinovi pitaju aplikaciju Glazba ili Spotify što se reproducira kako bi prikazali trenutačnu pjesmu i upravljali reprodukcijom te traže od Findera da isprazni smeće ili otvori prozor s informacijama kad koristite takav skin."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A skinek megkérdezik a Zene vagy a Spotify appot, mi szól éppen, hogy megjelenítsék az aktuális számot és vezéreljék a lejátszást, illetve megkérik a Findert a Kuka ürítésére vagy egy Információ ablak megnyitására, amikor ilyen skint használ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skin menanyakan kepada Musik atau Spotify apa yang sedang diputar untuk menampilkan trek saat ini dan mengontrol pemutaran, serta meminta Finder mengosongkan Tong Sampah atau membuka jendela Dapatkan Info saat Anda menggunakan skin seperti itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gli skin chiedono a Musica o a Spotify cosa è in riproduzione per mostrare il brano attuale e controllare la riproduzione, e chiedono al Finder di svuotare il Cestino o di aprire una finestra Ottieni informazioni quando usi uno di questi skin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "そのようなスキンを使用すると、現在の曲を表示して再生を操作するためにミュージックまたは Spotify に再生中の内容を問い合わせたり、ゴミ箱を空にしたり「情報を見る」ウインドウを開いたりするよう Finder に依頼したりします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이러한 스킨을 사용하면 현재 트랙을 표시하고 재생을 제어하기 위해 음악 또는 Spotify에 재생 중인 항목을 묻고, Finder에 휴지통 비우기나 정보 가져오기 윈도우 열기를 요청합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apvalkalai klausia programos „Muzika“ arba „Spotify“, kas groja, kad parodytų dabartinį takelį ir valdytų atkūrimą, ir prašo programos „Finder“ ištuštinti šiukšlinę arba atidaryti informacijos langą, kai naudojate tokį apvalkalą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apvalki vaicā lietotnei Mūzika vai Spotify, kas tiek atskaņots, lai rādītu pašreizējo celiņu un vadītu atskaņošanu, un lūdz programmai Finder iztukšot atkritni vai atvērt informācijas logu, kad izmantojat šādu apvalku."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skin bertanya kepada Muzik atau Spotify apa yang sedang dimainkan untuk menunjukkan trek semasa dan mengawal main balik, dan meminta Finder mengosongkan Tong Sampah atau membuka tetingkap Dapatkan Maklumat apabila anda menggunakan skin sedemikian."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skins spør Musikk eller Spotify om hva som spilles, for å vise gjeldende spor og styre avspillingen, og ber Finder tømme papirkurven eller åpne et infovindu når du bruker et slikt skin."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skins vragen Muziek of Spotify wat er wordt afgespeeld om het huidige nummer te tonen en het afspelen te regelen, en vragen de Finder de prullenmand te legen of een infovenster te openen wanneer je zo'n skin gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skórki pytają aplikację Muzyka lub Spotify, co jest odtwarzane, aby pokazać bieżący utwór i sterować odtwarzaniem, oraz proszą Findera o opróżnienie kosza lub otwarcie okna informacji, gdy używasz takiej skórki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os skins perguntam ao Música ou ao Spotify o que está tocando para mostrar a faixa atual e controlar a reprodução, e pedem ao Finder para esvaziar o Lixo ou abrir uma janela Obter Informações quando você usa um desses skins."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os skins perguntam à app Música ou ao Spotify o que está a tocar para mostrar a faixa atual e controlar a reprodução, e pedem ao Finder para esvaziar o Lixo ou abrir uma janela Obter informações quando utiliza um destes skins."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skinurile întreabă aplicația Muzică sau Spotify ce se redă pentru a afișa piesa curentă și a controla redarea și cer aplicației Finder să golească coșul sau să deschidă o fereastră Obțineți informații când folosiți un astfel de skin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Скины спрашивают у «Музыки» или Spotify, что сейчас играет, чтобы показать текущий трек и управлять воспроизведением, а также просят Finder очистить Корзину или открыть окно «Свойства», когда Вы пользуетесь таким скином."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skiny sa pýtajú aplikácie Hudba alebo Spotify, čo práve hrá, aby zobrazili aktuálnu skladbu a ovládali prehrávanie, a žiadajú Finder o vyprázdnenie koša alebo otvorenie okna Informácie, keď taký skin používate."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Preobleke vprašajo program Glasba ali Spotify, kaj se predvaja, da prikažejo trenutno skladbo in upravljajo predvajanje, ter Finder prosijo, naj izprazni koš ali odpre okno z informacijami, ko uporabljate tako preobleko."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Скинови питају апликацију Музика или Spotify шта се репродукује како би приказали тренутну песму и управљали репродукцијом, и траже од Finder-а да испразни смеће или отвори прозор са информацијама када користите такав скин."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skinovi pitaju aplikaciju Muzika ili Spotify šta se reprodukuje kako bi prikazali trenutnu pesmu i upravljali reprodukcijom, i traže od Findera da isprazni smeće ili otvori prozor sa informacijama kada koristite takav skin."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skins frågar Musik eller Spotify vad som spelas för att visa aktuellt spår och styra uppspelningen, och ber Finder tömma papperskorgen eller öppna ett infofönster när du använder en sådan skin."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "สกินจะถามแอปเพลงหรือ Spotify ว่ากำลังเล่นอะไรอยู่เพื่อแสดงเพลงปัจจุบันและควบคุมการเล่น และขอให้ Finder ล้างถังขยะหรือเปิดหน้าต่างรับข้อมูลเมื่อคุณใช้สกินดังกล่าว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Böyle bir skin kullandığınızda skin'ler, geçerli parçayı göstermek ve çalmayı denetlemek için Müzik'e veya Spotify'a neyin çaldığını sorar; ayrıca Finder'dan Çöp Sepeti'ni boşaltmasını veya Bilgi Al penceresini açmasını ister."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Скіни запитують «Музику» або Spotify, що зараз грає, щоб показати поточну доріжку й керувати відтворенням, а також просять Finder очистити Смітник або відкрити вікно «Інформація», коли ви користуєтеся таким скіном."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skin hỏi Nhạc hoặc Spotify đang phát gì để hiển thị bài hát hiện tại và điều khiển phát lại, đồng thời yêu cầu Finder dọn sạch Thùng rác hoặc mở cửa sổ Lấy thông tin khi bạn dùng skin như vậy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "使用此类皮肤时，皮肤会询问“音乐”或 Spotify 正在播放的内容，以显示当前曲目并控制播放；也会请求访达清倒废纸篓或打开“显示简介”窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "使用此類皮膚時，皮膚會詢問「音樂」或 Spotify 正在播放的內容，以顯示目前曲目並控制播放；也會要求 Finder 清空垃圾桶或打開「取得資訊」視窗。"
          }
        }
      }
    },
    "NSAudioCaptureUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تعرض واجهات تصوير الصوت مستوى الصوت الذي يشغّله جهاز Mac وطيفه. يُحلَّل الصوت على جهاز Mac أثناء تحميل مثل هذه الواجهة؛ ولا يُسجَّل أو يُحفظ أو يُرسل إلى أي مكان أبدًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Скиновете за аудиовизуализация показват нивото и спектъра на звука, който възпроизвежда вашият Mac. Звукът се анализира на вашия Mac, докато такъв скин е зареден; той никога не се записва, не се съхранява и не се изпраща никъде."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skiny vizualizace zvuku zobrazují úroveň a spektrum zvuku, který Mac přehrává. Zvuk se analyzuje na Macu, dokud je takový skin načtený; nikdy se nenahrává, neukládá ani nikam neodesílá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lydvisualiseringsskins viser niveauet og spektret for den lyd, din Mac afspiller. Lyden analyseres på din Mac, mens et sådant skin er indlæst; den optages, arkiveres eller sendes aldrig nogen steder hen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Audio-Visualisierungs-Skins zeigen Pegel und Spektrum des Tons, den dein Mac abspielt. Der Ton wird auf deinem Mac analysiert, solange ein solcher Skin geladen ist; er wird nie aufgenommen, gespeichert oder irgendwohin gesendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Τα skin οπτικοποίησης ήχου εμφανίζουν τη στάθμη και το φάσμα του ήχου που αναπαράγει το Mac σας. Ο ήχος αναλύεται στο Mac σας όσο ένα τέτοιο skin είναι φορτωμένο· ποτέ δεν ηχογραφείται, δεν αποθηκεύεται και δεν αποστέλλεται πουθενά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio visualizer skins show the level and spectrum of the sound your Mac is playing. The audio is analysed on your Mac while such a skin is loaded; it is never recorded, saved or sent anywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los skins de visualización de audio muestran el nivel y el espectro del sonido que reproduce tu Mac. El audio se analiza en tu Mac mientras uno de esos skins está cargado; nunca se graba, se guarda ni se envía a ningún sitio."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Heli visualiseerimise skinid näitavad Maci esitatava heli taset ja spektrit. Heli analüüsitakse sinu Macis, kuni selline skin on laaditud; seda ei salvestata, säilitata ega saadeta kuhugi."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Äänen visualisointiskinit näyttävät Macin toistaman äänen tason ja spektrin. Ääni analysoidaan Macissa, kun tällainen skin on ladattu; sitä ei koskaan tallenneta, säilytetä eikä lähetetä minnekään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les skins de visualisation audio affichent le niveau et le spectre du son lu par votre Mac. Le son est analysé sur votre Mac tant qu’un tel skin est chargé ; il n’est jamais enregistré, conservé ni envoyé où que ce soit."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "סקינים להמחשה חזותית של שמע מציגים את העוצמה והספקטרום של הצליל שה-Mac מנגן. השמע מנותח ב-Mac כל עוד סקין כזה טעון; הוא לעולם אינו מוקלט, נשמר או נשלח לשום מקום."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skinovi za vizualizaciju zvuka prikazuju razinu i spektar zvuka koji reproducira vaš Mac. Zvuk se analizira na vašem Macu dok je takav skin učitan; nikada se ne snima, ne sprema i ne šalje nikamo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A hangvizualizáló skinek a Mac által lejátszott hang szintjét és spektrumát jelenítik meg. A hang elemzése a Macen történik, amíg ilyen skin be van töltve; soha nem lesz rögzítve, mentve vagy bárhová elküldve."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skin visualisasi audio menampilkan level dan spektrum suara yang diputar Mac Anda. Audio dianalisis di Mac Anda selama skin seperti itu dimuat; audio tidak pernah direkam, disimpan, atau dikirim ke mana pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gli skin di visualizzazione audio mostrano il livello e lo spettro del suono riprodotto dal Mac. L’audio viene analizzato sul Mac mentre uno di questi skin è caricato; non viene mai registrato, salvato o inviato da nessuna parte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "オーディオビジュアライザのスキンは、Mac で再生中のサウンドのレベルとスペクトルを表示します。オーディオはそのようなスキンが読み込まれている間 Mac 上で解析されるだけで、録音、保存、送信されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "오디오 시각화 스킨은 Mac에서 재생 중인 사운드의 레벨과 스펙트럼을 표시합니다. 오디오는 이러한 스킨이 로드되어 있는 동안 Mac에서 분석되며 녹음, 저장 또는 전송되지 않습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Garso vizualizavimo apvalkalai rodo jūsų „Mac“ atkuriamo garso lygį ir spektrą. Garsas analizuojamas jūsų „Mac“, kol toks apvalkalas įkeltas; jis niekada neįrašomas, nesaugomas ir niekur nesiunčiamas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Audio vizualizācijas apvalki rāda jūsu Mac datorā atskaņotās skaņas līmeni un spektru. Skaņa tiek analizēta jūsu Mac datorā, kamēr šāds apvalks ir ielādēts; tā nekad netiek ierakstīta, saglabāta vai kaut kur nosūtīta."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skin visualisasi audio menunjukkan aras dan spektrum bunyi yang dimainkan oleh Mac anda. Audio dianalisis pada Mac anda semasa skin sedemikian dimuatkan; ia tidak pernah dirakam, disimpan atau dihantar ke mana-mana."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lydvisualiseringsskins viser nivået og spekteret til lyden Macen spiller av. Lyden analyseres på Macen mens et slikt skin er lastet inn; den blir aldri tatt opp, arkivert eller sendt noe sted."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Audiovisualisatieskins tonen het niveau en het spectrum van het geluid dat je Mac afspeelt. Het geluid wordt op je Mac geanalyseerd zolang zo'n skin geladen is; het wordt nooit opgenomen, bewaard of ergens naartoe gestuurd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skórki wizualizacji dźwięku pokazują poziom i widmo dźwięku odtwarzanego przez Maca. Dźwięk jest analizowany na Macu, gdy taka skórka jest wczytana; nigdy nie jest nagrywany, zachowywany ani nigdzie wysyłany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os skins de visualização de áudio mostram o nível e o espectro do som que o seu Mac está reproduzindo. O áudio é analisado no seu Mac enquanto um desses skins está carregado; ele nunca é gravado, salvo nem enviado para lugar nenhum."
