// Every production of the grammar (§2.3), written the canonical way.
info {
    name: "All productions"
    description: "Every construct of the grammar."
    size: .medium
    permissions: [.music, .location]
    network: ["api.example.com"]
    deskVersion: 1
    requires: "1.0"
}

options {
    weekStart = Picker("Week starts on", [.sunday, .monday], default: .sunday)
    highlight = ColorPicker("Highlight color", default: .accent)
        .help("Used for today")
    Section("More") {
        city = Input("City", default: "Oslo")
        seconds = Toggle("Show seconds").hidden(if: not options.showClock)
    }
}

widget {
    variable page = 0
    saved note = ""
    computed month = calendar.month(offset: page, weekStart: options.weekStart)
    computed load = (cpu.usage > 80% and not battery.charging) or memory.free < 2GB
    computed title = music.playing ? music.title.ifMissing("Nothing") : "Paused"

    Column(spacing: 8, align: .left) {
        Text("{cpu.usage}% · {memory.used, unit: .gb} · {time.now, format: "HH:mm"} {{braces}}")
            .font(.caption)
            .color(.dim, if: load)
        Row {
            Icon("chevron.left").onClick { page = page - 1 }
            Spacer()
            Label(title, icon: "music.note")
                .hover { .color(options.highlight); .scale(104%) }
                .pressed { .scale(96%) }
        }
        if widget.size == .large {
            Graph(values: weather.hourly.temperature, shape: .area)
        } else if widget.size == .medium {
            Progress(memory.used, total: 16GB)
        } else {
            Gauge(cpu.usage, shape: .arc)
        }
        Grid(columns: 7) {
            for day in month.days {
                Text("{day.number}")
                    .style(dateCell)
                    .style(todayCell, if: day.isToday)
                    .hidden(if: not day.inMonth)
            }
        }
        Freeform {
            Text(music.title).name(song).position(x: 10, y: 10)
            Text(music.artist).position(x: song.left, y: song.bottom + 4, anchor: .topLeft)
            Path(#"M0 10 L10 0 L20 10 Z"#).fill(.orange)
        }
        Input(note, placeholder: "Write something…").onSubmit { log("saved {note}") }
    }
    .padding(14)
    .background(gradient(.blue, .purple, angle: 180))
    .menu {
        Item("Open Calendar").onClick { open("Calendar") }
        Divider()
        Menu("Week starts on") {
            Item("Monday").onClick { options.weekStart = .monday }
        }
    }
    .every(1s) {
        if page > 3 { page = 0 } else { page = page + 1 }
        for name in ["details", "chart"] { hide(name) }
        after(2s) { show(details) }
    }
    .onScroll(.up) { volume.set(volume.level + 5%) }
    .when(battery.level < 20%) { notify("Battery low") }
    .onChange(of: music.title) { note = "" }
}

style dateCell  { .font(13).size(28, 24) }
style todayCell { .font(13, .semibold).color(.white).background(options.highlight).rounded(.full) }

translations {
    "zh-Hans" {
        "All productions": "全部语法"
        "Week starts on": "每周从哪天开始"
    }
}

component Card(title: String = "Card") {
    Text(title)
}

script {
    const values = [1, 2, 3].map((x) => `${x}`); // not Desk yet
}
