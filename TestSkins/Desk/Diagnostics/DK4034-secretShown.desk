// DK4034 secretShown
//== expect: DK4034
//== also: DK8104
info { name: "T", network: ["x.com"] }
options { apiKey = Secret("API key") }
widget { Text(options.apiKey) }
//== negative
info { name: "T", network: ["x.com"] }
options { apiKey = Secret("API key") }
widget { Text("{web.json("https://x.com/?k={options.apiKey}").a}") }
