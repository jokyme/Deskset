; Nocturne · the styles its meters share (see Nocturne.ini).

[StyleLabel]
FontFace=#FontName#
FontSize=11
FontColor=#AccentColor#
StringStyle=Bold
AntiAlias=1

[StyleValue]
FontFace=#FontName#
FontSize=15
FontColor=#TextColor#
StringStyle=Bold
AntiAlias=1

[StyleBar]
W=(#BarWidth#)
H=4
BarColor=72,212,232
SolidColor=255,255,255,26
BarOrientation=Horizontal

[StyleButton]
FontFace=#FontName#
FontSize=10
FontColor=#AccentColor#
SolidColor=0,0,0,1
LeftMouseUpAction=[!SetOption #CURRENTSECTION# FontColor 255,255,255]
